#!/usr/bin/env python3
import argparse
from datetime import datetime
import zoneinfo


def find_tz_key(raw: str) -> str:
    """
    Finds the fully-qualified timezone if available, otherwise returns the
    input.

    "lagos" becomes "Africa/Lagos". "garbage" becomes "garbage".
    """
    raw = raw.lower()
    for tz in zoneinfo.available_timezones():
        if tz.split("/")[-1].lower() == raw:
            return tz
    return raw


def main() -> None:
    parser = argparse.ArgumentParser(description="print the time in a timezone")
    parser.add_argument("timezone", type=str, help="'Africa/Lagos' or 'lagos'")
    args = parser.parse_args()

    tz_key = find_tz_key(args.timezone)

    try:
        tz = zoneinfo.ZoneInfo(tz_key)
    except Exception:
        parser.error("invalid timezone")

    print(datetime.now(tz).strftime("%Y-%m-%d %H:%M:%S %Z%z"))


if __name__ == "__main__":
    main()
